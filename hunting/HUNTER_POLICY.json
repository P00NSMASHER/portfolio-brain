{
  "schema_version": "1.0.0",
  "hunter_id": "portfolio-autonomous-hunter-v1",
  "enabled": true,
  "authority_class": "OBSERVE",
  "objective_function": "DISCOVER_SUPPLY_SEPARATELY_FROM_DEMAND_AND_ONLY_CONNECT_TO_EXTERNAL_VALUE_AFTER_MARKET_EVIDENCE",
  "repository_count_reward": 0,
  "source_allowlist": [
    "PUBLIC_GITHUB"
  ],
  "public_content_trust": "UNTRUSTED_INPUT_NOT_INSTRUCTION",
  "candidate_reuse_rights": "NOT_GRANTED_BY_DISCOVERY",
  "model_calls_allowed": 0,
  "downstream_writes_allowed": 0,
  "external_actions_allowed": 0,
  "budgets": {
    "max_objectives_per_cycle": 5,
    "exploration_fraction": 0.2,
    "max_queries_per_objective": 2,
    "max_search_results_per_query": 5,
    "max_candidates_inspected_per_cycle": 20,
    "max_api_requests_per_cycle": 80,
    "max_tree_paths_per_candidate": 2000,
    "max_output_bytes": 5242880,
    "max_runtime_seconds": 240,
    "retry_limit": 2,
    "retry_backoff_seconds": 2,
    "max_candidates_inspected_per_query": 2
  },
  "learning": {
    "minimum_cycles_before_strategy_adjustment": 5,
    "minimum_inspections_before_strategy_adjustment": 20,
    "negative_query_suppression_after": 2,
    "verified_outcomes_only_for_value_credit": true,
    "exploration_floor_fraction": 0.2,
    "verified_outcome_strategy_priority": true,
    "verified_outcome_priority_mode": "ORDER_EXPLOIT_STRATEGIES_BY_VERIFIED_VALUE_OUTCOMES",
    "unverified_activity_cannot_increase_strategy_priority": true,
    "minimum_verified_outcomes_before_strategy_priority": 2,
    "verified_outcome_priority_requires_existing_activity_maturity": true,
    "priority_maturity_labels": {
      "below_gate": "WARMUP",
      "at_or_above_gate": "MATURE"
    },
    "technical_feedback_class": "TECHNICAL_VERIFIED",
    "technical_feedback_may_improve_hunter_search": true,
    "technical_feedback_may_increase_business_investment": false
  },
  "state_persistence": {
    "mode": "GITHUB_ACTIONS_ARTIFACT",
    "artifact_name": "portfolio-hunter-state",
    "retention_days": 30,
    "seed_file": "hunting/HUNTER_STATE_SEED.json",
    "sanitized_only": true
  },
  "kill_switches": {
    "repository_variable": "PORTFOLIO_HUNTER_DISABLED",
    "file": "hunting/KILL_SWITCH.json"
  },
  "candidate_evaluation": {
    "hard_reject_reasons": [
      "NO_IMPLEMENTATION_PATHS"
    ],
    "terminal_duplicate_reason": "EXACT_REVISION_CAPABILITY_DUPLICATE",
    "soft_signals_do_not_reject": true,
    "ranking": {
      "max_score": 10,
      "weights": {
        "implementation_presence": 2,
        "source_capability_signal": 4,
        "test_presence": 2,
        "test_capability_signal": 1,
        "docs_capability_signal": 1
      },
      "bands": {
        "HIGH": {
          "min_score": 8
        },
        "MEDIUM": {
          "min_score": 5
        },
        "LOW": {
          "min_score": 0
        }
      },
      "value_credit_source": "VERIFIED_OUTCOMES_ONLY"
    },
    "proposal_gate": {
      "minimum_rank_band": "MEDIUM",
      "max_experiment_proposals_per_cycle": 6,
      "low_rank_disposition": "RETAIN_OBSERVED_WITHOUT_PROPOSAL",
      "value_credit_source": "VERIFIED_OUTCOMES_ONLY"
    }
  },
  "query_generation": {
    "taxonomy_file": "hunting/QUERY_CONCEPTS.json",
    "repository_search_mode": "METADATA_FIRST_THEN_EXACT_REVISION_STRUCTURAL_INSPECTION",
    "portfolio_brand_names_default": false,
    "rotate_queries_by_state_sequence": true,
    "prefer_lowest_negative_hits": true,
    "structural_ranking_uses_semantic_concepts": true
  },
  "proposal_persistence": {
    "mode": "GITHUB_ACTIONS_ARTIFACT",
    "artifact_name": "portfolio-hunter-proposal-state",
    "retention_days": 30,
    "seed_file": "hunting/HUNTER_PROPOSAL_STATE_SEED.json",
    "sanitized_only": true,
    "downstream_authority": "OBSERVE",
    "max_backlog_proposals": 96,
    "carry_forward_prior_proposals": true,
    "origin_metadata_required": true,
    "compaction_policy": "DROP_OLDEST_LAST_SEEN_ONLY_AFTER_BACKLOG_CAP"
  },
  "inspection_failure_handling": {
    "candidate_disposition": "UNAVAILABLE_NOT_REJECTED",
    "reason_code": "CANDIDATE_INSPECTION_UNAVAILABLE",
    "counts_against_inspection_budget": true,
    "records_negative_query_knowledge": false,
    "cycle_behavior": "CONTINUE_BOUNDED"
  },
  "proposal_review_persistence": {
    "mode": "GITHUB_ACTIONS_ARTIFACT",
    "artifact_name": "portfolio-hunter-proposal-review-state",
    "retention_days": 30,
    "seed_file": "hunting/HUNTER_PROPOSAL_REVIEW_STATE_SEED.json",
    "sanitized_only": true,
    "authority_class": "OBSERVE",
    "rights_resolution": "NONE"
  },
  "signal_separation": {
    "supply_sensor": "PUBLIC_GITHUB",
    "demand_sensor": "PORTFOLIO_SANITIZED_MARKET_EVIDENCE",
    "github_supply_is_demand": false,
    "supply_only_can_authorize_commercial_build": false,
    "demand_evidence_classes": [
      "MARKET_VERIFIED",
      "REVENUE_VERIFIED"
    ],
    "signal_router": "hunting/signal_router.py"
  },
  "downstream_lifecycle": {
    "mode": "EVIDENCE_GATED_PROJECTION_OVER_EXISTING_REVIEW_AND_FACTORY_EVIDENCE",
    "module": "hunting/lifecycle.py",
    "stages": [
      "DISCOVERED",
      "REVIEWED",
      "ACCEPTED_FOR_WORK",
      "IMPLEMENTED",
      "TECHNICALLY_VERIFIED",
      "MARKET_VERIFIED",
      "REVENUE_VERIFIED"
    ],
    "review_can_self_authorize_work": false,
    "explicit_acceptance_receipt_required": true,
    "implementation_mode": "ISOLATED_REIMPLEMENTATION_NO_SOURCE_COPY",
    "governed_factory": "software_factory/software_factory.py",
    "automatic_merge_authority_granted": false,
    "automatic_deployment_authority_granted": false,
    "technical_evidence_can_claim_market_value": false,
    "technical_evidence_can_claim_revenue_value": false,
    "market_evidence_kind": "MARKET_OUTCOME",
    "revenue_evidence_kind": "REVENUE_OUTCOME",
    "new_state_journal_domain_required": false,
    "bridge_module": "hunting/downstream_lifecycle.py",
    "persistence_artifact_name": "portfolio-hunter-lifecycle-state",
    "seed_file": "hunting/HUNTER_LIFECYCLE_STATE_SEED.json",
    "acceptance_approval_code": "HUNTER_ACCEPT_FOR_WORK",
    "acceptance_source_binding": "EXACT_REVIEW_ID_AND_REVIEW_HASH",
    "production_target_scope": "CURRENT_WRITE_ENABLED_REPOSITORY_ONLY",
    "recurring_bridge_workflow": ".github/workflows/portfolio-autonomous-scheduler.yml"
  }
}
