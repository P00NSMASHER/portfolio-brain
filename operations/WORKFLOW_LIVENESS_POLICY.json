{
  "schema_version": "1.0.0",
  "liveness_id": "portfolio-core-workflow-liveness-v1",
  "enabled": true,
  "default_branch": "main",
  "max_api_requests_per_cycle": 14,
  "max_history_pages": 3,
  "max_dispatches_per_cycle": 2,
  "recent_failure_retry_after_minutes": 35,
  "authority_class": "NONE",
  "dispatch_authority_effect": "NONE",
  "hard_stop_behavior": "NONPAID_RECOVERY_CONTINUES",
  "targets": [
    {
      "workflow_name": "portfolio-autonomous-scheduler",
      "workflow_file": "portfolio-autonomous-scheduler.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 5,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 100,
      "priority": 1,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "portfolio-autonomous-scheduler",
      "admission_job_id": "schedule"
    },
    {
      "workflow_name": "runtime-hourly-sync",
      "workflow_file": "runtime-hourly-sync.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 5,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 100,
      "priority": 2,
      "admission_domain": "COST_WRAPPER",
      "admission_workflow_id": "runtime-worker",
      "admission_job_id": "runtime-sync"
    },
    {
      "workflow_name": "agent-heartbeat-sweep",
      "workflow_file": "agent-heartbeat-sweep.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 2,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 160,
      "priority": 3,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "agent-heartbeat-sweep",
      "admission_job_id": "heartbeat"
    },
    {
      "workflow_name": "hunter-autonomous-cycle",
