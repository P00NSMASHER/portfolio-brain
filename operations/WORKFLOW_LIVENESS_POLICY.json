      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 5,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 420,
      "priority": 4,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "hunter-autonomous-cycle",
