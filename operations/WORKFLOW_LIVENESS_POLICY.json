{
  "schema_version": "1.0.0",
  "liveness_id": "portfolio-core-workflow-liveness-v1",
  "enabled": true,
  "default_branch": "main",
  "max_api_requests_per_cycle": 18,
  "max_history_pages": 3,
  "max_dispatches_per_cycle": 2,
  "recent_failure_retry_after_minutes": 35,
  "authority_class": "NONE",
  "dispatch_authority_effect": "NONE",
  "hard_stop_behavior": "NONPAID_RECOVERY_CONTINUES",
  "targets": [
    {
      "workflow_name": "portfolio-autonomous-scheduler",
      "workflow_file": "portfolio-autonomous-scheduler.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 5,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 100,
      "priority": 1,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "portfolio-autonomous-scheduler",
      "admission_job_id": "schedule",
      "proof_artifact_name": "portfolio-scheduler-state",
      "proof_member": "execution_cycle_receipt.json",
      "proof_kind": "SCHEDULER_EXECUTION"
    },
    {
      "workflow_name": "runtime-hourly-sync",
      "workflow_file": "runtime-hourly-sync.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 5,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 100,
      "priority": 2,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "runtime-worker",
      "admission_job_id": "runtime-sync",
      "proof_artifact_name": "portfolio-runtime-state",
      "proof_member": "cycle_receipt.json",
      "proof_kind": "RUNTIME_SYNC"
    },
    {
      "workflow_name": "agent-heartbeat-sweep",
      "workflow_file": "agent-heartbeat-sweep.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 8,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 160,
      "priority": 3,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "agent-heartbeat-sweep",
      "admission_job_id": "heartbeat",
      "proof_artifact_name": "portfolio-agent-heartbeat-state",
      "proof_member": "agent_heartbeat_state.json",
      "proof_kind": "HEARTBEAT_SWEEP"
    },
    {
      "workflow_name": "hunter-autonomous-cycle",
      "workflow_file": "hunter-autonomous-cycle.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 5,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 420,
      "priority": 4,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "hunter-autonomous-cycle",
      "admission_job_id": "hunt",
      "proof_artifact_name": "portfolio-hunter-state",
      "proof_member": "hunt_cycle_receipt.json",
      "proof_kind": "HUNTER_CYCLE"
    },
    {
      "workflow_name": "portfolio-notification-cycle",
      "workflow_file": "portfolio-notification-cycle.yml",
      "project_ids": [
        "PRJ-000"
      ],
      "estimated_minutes": 8,
      "authority_class": "OBSERVE",
      "max_start_age_minutes": 420,
      "priority": 5,
      "admission_domain": "WORKLOAD",
      "admission_workflow_id": "portfolio-notification-cycle",
      "admission_job_id": "notify",
      "proof_artifact_name": "portfolio-notification-state",
      "proof_member": "notification_cycle_receipt.json",
      "proof_kind": "NOTIFICATION_CYCLE"
    }
  ],
  "invariants": [
    "Recovery never bypasses a target workflow's own workload/cost admission, authority gates, kill switches, or concurrency controls.",
    "A queued or in-progress target is never duplicated.",
    "Only a trusted event for the exact workflow file on the default branch can prove target liveness.",
    "A failed/cancelled target may be retried only after the configured failure retry age.",
    "Workload-controlled targets are previewed against workload_control/WORKLOAD_POLICY.json before dispatch.",
    "Paid hard stops never suppress WORKLOAD-domain recovery; paid model execution remains governed by its separate cost wrapper.",
    "A paid hard stop does not suppress recovery of non-paid workload targets.",
    "At most two workflow_dispatch calls may be emitted per watchdog cycle.",
    "A recent completed run is healthy only when its exact run artifact contains valid substantive-work proof.",
    "Proof artifacts are bound to the exact workflow run ID and are independently validated before they can suppress recovery.",
    "Missing, expired, malformed, or semantically invalid proof remains explicitly unverified and never paints the target green.",
    "A successful run with missing or invalid work proof becomes recoverable after the bounded unverified-work retry window."
  ],
  "unverified_work_retry_after_minutes": 30
}
