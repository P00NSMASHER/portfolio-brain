{
  "schema_version": "1.0.0",
  "clock_id": "portfolio-redundant-schedule-clock-v1",
  "default_branch": "main",
  "authority_class": "NONE",
  "dispatch_authority_effect": "NONE",
  "source_workflows": [
    {
      "name": "portfolio-schedule-delivery",
      "path": ".github/workflows/portfolio-schedule-delivery.yml",
      "events": [
        "schedule"
      ]
    },
    {
      "name": "verified-feedback-bootstrap",
      "path": ".github/workflows/verified-feedback-bootstrap.yml",
      "events": [
        "schedule"
      ]
    },
    {
      "name": "portfolio-state-checkpoint-candidate",
      "path": ".github/workflows/portfolio-state-checkpoint-candidate.yml",
      "events": [
        "schedule"
      ]
    },
    {
      "name": "runtime-daily-learning",
      "path": ".github/workflows/runtime-daily-learning.yml",
      "events": [
        "schedule"
      ]
    }
  ],
  "target_workflows": [
    {
      "name": "runtime-hourly-sync",
      "file": "runtime-hourly-sync.yml",
      "cadence": "HOURLY"
    },
    {
      "name": "portfolio-autonomous-scheduler",
      "file": "portfolio-autonomous-scheduler.yml",
      "cadence": "HOURLY"
    },
    {
      "name": "portfolio-cost-watchdog",
      "file": "portfolio-cost-watchdog.yml",
      "cadence": "HOURLY"
    },
    {
      "name": "command-center-pages",
      "file": "command-center-pages.yml",
      "cadence": "HOURLY"
    },
    {
      "name": "agent-heartbeat-sweep",
      "file": "agent-heartbeat-sweep.yml",
      "cadence": "EVERY_2_HOURS"
    },
    {
      "name": "hunter-autonomous-cycle",
      "file": "hunter-autonomous-cycle.yml",
      "cadence": "EVERY_6_HOURS"
    },
    {
      "name": "portfolio-notification-cycle",
      "file": "portfolio-notification-cycle.yml",
      "cadence": "EVERY_6_HOURS"
    },
    {
      "name": "portfolio-state-reducer",
      "file": "portfolio-state-reducer.yml",
      "cadence": "DAILY_04_UTC"
    }
  ],
  "dedupe_window_minutes": 55,
  "max_dispatches_per_tick": 8,
  "max_api_requests": 60
}
