{
  "schema_version": "1.0.0",
  "runtime_id": "portfolio-continuous-observation-v1",
  "authority_class": "OBSERVE",
  "enabled": true,
  "model_calls_allowed": 0,
  "downstream_writes_allowed": 0,
  "external_actions_allowed": 0,
  "state_persistence": {
    "mode": "GITHUB_ACTIONS_ARTIFACT",
    "artifact_name": "portfolio-runtime-state",
    "retention_days": 30,
    "bootstrap_cursor_file": "adapters/cursors/repositories.json",
    "sanitized_only": true
  },
  "budgets": {
    "max_repositories_per_cycle": 8,
    "max_api_requests_per_cycle": 40,
    "max_changed_files_per_repository": 500,
    "max_total_changed_files_per_cycle": 1500,
    "max_output_bytes": 5242880,
    "max_runtime_seconds": 240,
    "retry_limit": 2,
    "retry_backoff_seconds": 2
  },
  "kill_switches": {
    "repository_variable": "PORTFOLIO_RUNTIME_DISABLED",
    "file": "runtime/KILL_SWITCH.json"
  },
  "concurrency": {
    "group": "portfolio-runtime-state",
    "cancel_in_progress": false
  }
}
