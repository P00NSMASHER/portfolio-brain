{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-brain.local/schemas/VALUE_MEMORY_OUTCOME_SCHEMA.json",
  "title": "Portfolio Brain Value Memory Outcome Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","outcome_id","memory_id","event_id","project_id","objective_id",
    "reward","attribution_fraction","evidence_ids","evidence_state",
    "observer_actor_id","verifier_actor_id","verification_report_hash",
    "observed_at","verified_at"
  ],
  "properties": {
    "schema_version":{"const":"1.0.0"},
    "outcome_id":{"type":"string","pattern":"^MOUT-[A-Z0-9-]{8,}$"},
    "memory_id":{"type":"string","pattern":"^MEM-[A-Z0-9-]{8,}$"},
    "event_id":{"type":"string","pattern":"^EVT-[A-Z0-9-]{8,}$"},
    "project_id":{"type":"string","pattern":"^PRJ-[0-9]{3,}$"},
    "objective_id":{"type":"string","pattern":"^(OBJ-[0-9]{3,}|\\*)$"},
    "reward":{"type":"number","minimum":-1.0,"maximum":1.0},
    "attribution_fraction":{"type":"number","exclusiveMinimum":0.0,"maximum":1.0},
    "evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]{8,}$"},"uniqueItems":true,"minItems":1},
    "evidence_state":{"enum":["OBSERVED","VERIFIED","INFERRED","UNKNOWN","CONTRADICTED","STALE","INVALID"]},
    "observer_actor_id":{"type":"string","minLength":1,"maxLength":300},
    "verifier_actor_id":{"type":["string","null"],"minLength":1,"maxLength":300},
    "verification_report_hash":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
    "observed_at":{"type":"string","format":"date-time"},
    "verified_at":{"type":["string","null"],"format":"date-time"}
  }
}
