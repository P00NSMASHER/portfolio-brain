{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-brain.local/schemas/SOFTWARE_FACTORY_ACTION_SCHEMA.json",
  "title": "Portfolio Software Factory GitHub Action Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "operation",
    "factory_work_id",
    "repository_full_name",
    "default_branch",
    "branch_name",
    "base_sha",
    "expected_head_sha",
    "files",
    "commit_message",
    "pr_title",
    "pr_body",
    "action_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "action_id": {
      "type": "string",
      "pattern": "^SFA-[A-Z0-9-]+$"
    },
    "operation": {
      "enum": [
        "CREATE_BRANCH",
        "COMMIT_CANDIDATE",
        "CREATE_PR"
      ]
    },
    "factory_work_id": {
      "type": "string",
      "pattern": "^SFW-[A-Z0-9-]+$"
    },
    "repository_full_name": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "branch_name": {
      "type": "string",
      "pattern": "^factory/.+"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content_b64",
          "content_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content_b64": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "commit_message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "pr_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "pr_body": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "action_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
