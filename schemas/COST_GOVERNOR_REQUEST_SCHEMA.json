{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-brain/cost-governor-request/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "idempotency_key",
    "retry_group",
    "attempt",
    "resource_kind",
    "project_ids",
    "provider_id",
    "model_id",
    "workflow_id",
    "job_id",
    "authority_class",
    "data_classification",
    "estimated_usage",
    "evidence_refs",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^CGR-"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "retry_group": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "resource_kind": {"enum": ["MODEL_CALL", "API_CALL", "GITHUB_JOB"]},
    "project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provider_id": {"type": ["string", "null"]},
    "model_id": {"type": ["string", "null"]},
    "workflow_id": {"type": ["string", "null"]},
    "job_id": {"type": ["string", "null"]},
    "authority_class": {"enum": ["NONE", "OBSERVE", "EXPERIMENT", "MODIFY", "ACT"]},
    "data_classification": {"enum": ["PUBLIC", "SANITIZED", "PRIVATE_REFERENCE_ONLY"]},
    "estimated_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_usd", "input_tokens", "output_tokens", "model_calls", "api_calls", "github_job_starts", "github_runner_minutes"],
      "properties": {
        "cost_usd": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "api_calls": {"type": "integer", "minimum": 0},
        "github_job_starts": {"type": "integer", "minimum": 0},
        "github_runner_minutes": {"type": "integer", "minimum": 0}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_at": {"type": "string", "minLength": 1}
  }
}
