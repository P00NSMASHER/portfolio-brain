{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-brain.local/schemas/VALUE_MEMORY_SCHEMA.json",
  "title": "Portfolio Brain Shared Value Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","memory_id","memory_key","version","memory_kind","project_ids",
    "objective_id","scope","content","content_hash","provenance_evidence_ids",
    "truth_state","status","upstream_memory_id"
  ],
  "properties": {
    "schema_version":{"const":"1.0.0"},
    "memory_id":{"type":"string","pattern":"^MEM-[A-Z0-9-]{8,}$"},
    "memory_key":{"type":"string","minLength":1,"maxLength":200},
    "version":{"type":"string","minLength":1,"maxLength":80},
    "memory_kind":{"enum":["FACT","STRATEGY","ENGINEERING","RESEARCH","COMMERCIAL","PORTFOLIO","SELF_IMPROVEMENT"]},
    "project_ids":{"type":"array","items":{"type":"string","pattern":"^PRJ-[0-9]{3,}$"},"uniqueItems":true,"minItems":1},
    "objective_id":{"type":"string","pattern":"^(OBJ-[0-9]{3,}|\\*)$"},
    "scope":{"const":"GLOBAL"},
    "content":{"type":"object"},
    "content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "provenance_evidence_ids":{"type":"array","items":{"type":"string","pattern":"^EVD-[A-Z0-9-]{8,}$"},"uniqueItems":true,"minItems":1},
    "truth_state":{"enum":["OBSERVED","VERIFIED","INFERRED","UNKNOWN","CONTRADICTED","STALE","INVALID"]},
    "status":{"enum":["ACTIVE","RETIRED"]},
    "upstream_memory_id":{"type":"string","minLength":1,"maxLength":200}
  }
}
