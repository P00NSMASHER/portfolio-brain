{
  "schema_version": "1.0.0",
  "factory_id": "portfolio-software-factory-v1",
  "mode": "ISOLATED_BRANCH_PR_ONLY",
  "max_attempts": 3,
  "lease_seconds": 300,
  "branch_prefix": "factory/",
